load("@rules_cc//cc:defs.bzl", "cc_library")

# Port of the app/board.h interface to the S32G399A M7_0 core on the
# NXP S32G-VNP-RDB3 board. Symbols get pulled in via main.o's references
# (board_init/uart_init/uart_puts) which in turn pull clock.o/pinmux.o from
# this archive — no alwayslink needed.
#
# board_no_startup is the same peripheral code without the bare-metal
# startup archive, so apps that supply their own vector table (e.g.
# //app/threadx_hello) don't inherit the default one.
cc_library(
    name = "board_no_startup",
    srcs = [
        "board.c",
        "board_internal.h",
        "clock.c",
        "pinmux.c",
        "s32g3_regs.h",
        "uart.c",
    ],
    # M7 core clock after clock_init(): FIRC at 48 MHz. Consumed by
    # //app/threadx_hello:tx_initialize_low_level.S to size SysTick.
    defines = ["BOARD_CPU_HZ=48000000"],
    deps = [
        "//app:board_api",
        "//boards/common:printk",
    ],
    visibility = ["//app:__subpackages__"],
)

cc_library(
    name = "board",
    deps = [
        ":board_no_startup",
        "//boards/common:startup",
    ],
    visibility = ["//app:__pkg__"],
)

filegroup(
    name = "linker_script",
    srcs = ["m7_sram.ld"],
    visibility = ["//app:__subpackages__"],
)
