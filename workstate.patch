diff --git a/tools/t32/rdb3_m7_0/load.cmm b/tools/t32/rdb3_m7_0/load.cmm
new file mode 100644
index 000000000..f64ee3ad7
--- /dev/null
+++ b/tools/t32/rdb3_m7_0/load.cmm
@@ -0,0 +1,71 @@
+; Load and run hello-world on S32G399A M7_0 via TRACE32.
+;
+; Adapted from:
+;   t32/demo/arm/hardware/s32g3/s32g3-procevb3/s32g-procevb3-m7/s32g-procevb3_sieve_sram.cmm
+; With empty flash the M7 does not auto-boot; the ON ERROR fallback wakes it
+; via AXI-AP using the vendor's connect script.
+
+WinCLEAR
+
+RESet
+SYStem.CPU S32G399A-M7
+CORE.ASSIGN 1.
+SYStem.CONFIG.DEBUGPORTTYPE JTAG
+SYStem.Option DUALPORT ON
+SYStem.MemAccess DAP
+SYStem.JtagClock 10MHz
+Trace.DISable
+ETM.OFF
+ITM.OFF
+
+; Halt M7_0 in the BootROM before BL2 or any flashed image can run
+SYStem.Option ResBreak ON
+
+; If flash is empty SYStem.Up will fault, fall back to the M7 wake-up script.
+; ~~/ expands to the TRACE32 install root (SYS= in config.t32).
+ON ERROR GOSUB
+(
+  ON ERROR DEFault
+  DO ~~/demo/arm/hardware/s32g3/misc/s32g3_connect_m7_0.cmm
+  RETURN
+)
+SYStem.Up
+
+ON ERROR inherit
+
+; Kill watchdogs and prepare SRAM before loading the image.
+DO ~~/demo/arm/hardware/s32g3/misc/s32g3_disable_watchdog.cmm
+DO ~~/demo/arm/hardware/s32g3/misc/s32g3_init_sram.cmm
+
+; Load ELF from environment variable T32_ELF_PATH (set by wrapper)
+; or fall back to hardcoded path for manual testing.
+PRIVATE &elf_path
+&elf_path=OS.ENV(T32_ELF_PATH)
+
+IF "&elf_path"==""
+(
+  ; Fallback for manual testing - adjust path as needed
+  &elf_path="~~~~/../app.elf"
+  PRINT %WARNING "T32_ELF_PATH not set, using fallback: &elf_path"
+)
+ELSE
+(
+  PRINT "Loading ELF from T32_ELF_PATH: &elf_path"
+)
+
+Data.LOAD.Elf &elf_path
+
+; Point PC at the reset entry and run.
+Go.direct _reset
+WAIT 200.ms
+
+WinCLEAR
+Mode.Hll
+WinPOS 0. 0. 116. 26.
+List.auto
+WinPOS 120. 0. 100. 8.
+Frame.view
+WinPOS 120. 14.
+Register.view
+
+ENDDO
diff --git a/tools/t32/t32_run_under.sh b/tools/t32/t32_run_under.sh
new file mode 100644
index 000000000..3af62b9fc
--- /dev/null
+++ b/tools/t32/t32_run_under.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+# (c) The Exploration Company
+#
+# Wrapper for bazel run --run_under with Lauterbach T32.
+# This script bridges Bazel's build sandbox with the Nix-provided t32-run tool.
+#
+# Usage (via Bazel):
+#   bazel run --run_under=//tools/t32:t32_run_under //target:binary
+#   bazel run --config=m7_debug //rdb3_bringup_src:rdb3_m7_hello
+#
+# Bazel passes the built binary path as the last argument.
+# We extract it and pass it to t32-run which sets T32_ELF_PATH for load.cmm.
+
+set -euo pipefail
+
+# Last argument is the ELF path from Bazel's sandbox
+ELF_PATH="${@: -1}"
+
+# Verify the ELF exists
+if [[ ! -f "$ELF_PATH" ]]; then
+    echo "Error: ELF not found at $ELF_PATH" >&2
+    exit 1
+fi
+
+# Resolve to absolute path
+ELF_ABS="$(realpath "$ELF_PATH")"
+
+# T32 script directory for M7_0 target
+T32_DIR="tools/t32/rdb3_m7_0"
+
+if [[ ! -d "$T32_DIR" ]]; then
+    echo "Error: T32 directory not found: $T32_DIR" >&2
+    echo "Make sure you're running from the workspace root." >&2
+    exit 1
+fi
+
+echo "==========================================================="
+echo "Lauterbach T32 Debug Session"
+echo "==========================================================="
+echo "ELF Binary: $ELF_ABS"
+echo "Target:     S32G399A M7_0"
+echo "Platform:   RDB3"
+echo "==========================================================="
+echo ""
+
+# Check if t32-run is available (from Nix shell)
+if ! command -v t32-run &> /dev/null; then
+    echo "Error: t32-run not found in PATH" >&2
+    echo "Make sure you're in the Nix development shell:" >&2
+    echo "  nix develop" >&2
+    exit 1
+fi
+
+# Launch T32 via the Nix wrapper, passing ELF path and target directory
+exec t32-run "$ELF_ABS" "$T32_DIR"
diff --git a/tools/t32/trace32.nix b/tools/t32/trace32.nix
new file mode 100644
index 000000000..e8cc1feaa
--- /dev/null
+++ b/tools/t32/trace32.nix
@@ -0,0 +1,234 @@
+# (c) The Exploration Company
+#
+# Nix expression that sets up lauterbach t32 in the nix environment
+# The following instructions provide a set of commands that were used
+# to analyze the dependencies in case this expression may need to be updated
+# in the future.
+#
+# Direct runtime dependencies on the main .t32marm-wrapped binary
+# ```
+# readelf -d files/bin/pc_linux64/t32marm | grep NEEDED
+# ```
+#
+# Direct runtime dependencies on the qt6 shim t32screenqt6.so
+# ```
+# readelf -d files/bin/pc_linux64/t32screenqt6.so | grep NEEDED
+# ```
+#
+# Transitive misses detected trough autoPatchelfHook
+# ```
+# nix build .#trace32 2>&1 | grep -E "not satisfied|dependency .* not found"
+# ```
+# dlopen candidates from strings grepped the main elf
+# ```
+# strings files/bin/pc_linux64/.t32marm-wrapped | grep -E '\.so(\.[0-9]+)?$'
+# ```
+
+
+{ stdenv
+, lib
+, autoPatchelfHook
+, makeWrapper
+, glibc
+, gcc-unwrapped
+, openssl
+, curl
+, brotli
+, libkrb5
+, libssh2
+, zstd
+, libunistring
+, libidn2
+, libpsl
+, nghttp2
+, libnghttp3 ? null
+, ngtcp2 ? null
+, libuuid
+, keyutils
+, e2fsprogs
+, freetype
+, fontconfig
+, harfbuzz
+, icu
+, libpng
+, xorg
+, libxkbcommon
+, dbus
+, glib
+, expat
+, systemdLibs
+, liburing
+, libGL
+, libglvnd
+, qt6
+, bzip2
+, zlib
+, libb2
+, double-conversion
+, pcre2
+, md4c
+, graphite2
+, src
+}:
+
+stdenv.mkDerivation {
+  pname = "trace32";
+  version = "R.2026.02.000190766";
+  inherit src;
+
+  nativeBuildInputs = [ autoPatchelfHook makeWrapper ];
+
+  buildInputs = [
+    glibc
+    gcc-unwrapped.lib
+    openssl
+    curl
+    brotli
+    libkrb5
+    libssh2
+    zstd
+    libunistring
+    libidn2
+    libpsl
+    nghttp2
+    libuuid
+    keyutils
+    e2fsprogs
+
+    qt6.qtbase
+    qt6.qtsvg
+    freetype
+    fontconfig
+    harfbuzz
+    icu
+    libpng
+    libxkbcommon
+    dbus
+    glib
+    expat
+    systemdLibs
+    liburing
+    libGL
+    libglvnd
+    bzip2
+    zlib
+    libb2
+    double-conversion
+    pcre2
+    md4c
+    graphite2
+
+    xorg.libX11
+    xorg.libXext
+    xorg.libXau
+    xorg.libXdmcp
+    xorg.libxcb
+    xorg.libSM
+    xorg.libICE
+  ] ++ lib.optional (libnghttp3 != null) libnghttp3
+    ++ lib.optional (ngtcp2 != null) ngtcp2;
+
+  dontUnpack = true;
+  dontConfigure = true;
+  dontBuild = true;
+  dontWrapQtApps = true;
+
+  installPhase = ''
+    runHook preInstall
+
+    mkdir -p "$out"
+
+    # Dependencies for the linux-x64 install.
+    # Excludes mac/win/aarch64 binaries.
+    cp -r "$src/files/bin/pc_linux64" "$out/bin/"
+    cp -r "$src/files/demo"     "$out/demo"
+    cp -r "$src/files/licenses" "$out/licenses"
+    cp -r "$src/files/fonts"    "$out/fonts"
+    cp -r "$src/files/pdf"      "$out/pdf"
+
+    # Front-end configuration blobs and the autostart script.
+    for f in "$src"/files/*.t32 "$src"/files/autostart.cmm; do
+      cp "$f" "$out/"
+    done
+
+    chmod -R u+w "$out"
+
+    # Intel Trace Hub x64 demo binaries have been removed because they
+    # link against packages that nixpkgs does not carry.
+    rm -rf "$out/demo/x64/ith"
+
+    # writable tmp dir used by t32 for state.
+    mkdir -p "$out/tmp"
+    chmod 0777 "$out/tmp"
+
+    # udev rules for the LB debug hardware.
+    mkdir -p "$out/lib/udev/rules.d"
+    cp "$src/files/bin/pc_linux64/udev.conf/kernel_starting_4.14/10-lauterbach.rules" \
+       "$out/lib/udev/rules.d/"
+    cp "$src/files/bin/pc_linux64/udev.conf/kernel_starting_4.14/10-lauterbach_target.rules" \
+       "$out/lib/udev/rules.d/"
+
+    # Default config so `t32marm` works if launched without -c.
+    cat > "$out/config.t32" <<CONFIG
+    ; Auto-generated by tools/t32/trace32.nix
+    OS=
+    SYS=$out
+    TMP=$out/tmp
+
+    PBI=
+    USB
+    CONNECTIONMODE=AUTOCONNECT
+    CONFIG
+
+    runHook postInstall
+  '';
+
+  postFixup = ''
+    for bin in "$out/bin"/t32m*; do
+      case "$bin" in *.so|*.so.*|*/t32marm64) continue;; esac
+      [ -x "$bin" ] || continue
+      wrapProgram "$bin" \
+        --set-default T32SCREENSO t32screenqt6.so \
+        --prefix QT_PLUGIN_PATH : "${qt6.qtbase}/lib/qt-6/plugins" \
+        --prefix QT_QPA_PLATFORM_PLUGIN_PATH : "${qt6.qtbase}/lib/qt-6/plugins/platforms"
+    done
+  '';
+
+  autoPatchelfIgnoreMissingDeps = [
+    "t32cadi.so.1"
+    "t32caditrace.so"
+    "t32cevadislink.so"
+    "t32iris.so"
+    "t32screenqt5.so"
+    "t32screenqt6.so"
+    "t32_tas_api.so"
+    "libusb-1.0.so"
+    "bmcmci.so"
+    "hostmci.so"
+
+    "libXxf86vm.so.1"
+    "libgtk-3.so.0"
+    "libgdk-3.so.0"
+    "libatk-1.0.so.0"
+    "libpangocairo-1.0.so.0"
+    "libgdk_pixbuf-2.0.so.0"
+    "libcairo-gobject.so.2"
+    "libcairo.so.2"
+    "libpangoft2-1.0.so.0"
+    "libpango-1.0.so.0"
+
+    "libQt5PrintSupport.so.5"
+    "libQt5Svg.so.5"
+    "libQt5Widgets.so.5"
+    "libQt5Gui.so.5"
+    "libQt5Core.so.5"
+  ];
+
+  meta = with lib; {
+    description = "Lauterbach TRACE32 debugger";
+    homepage = "https://www.lauterbach.com";
+    license = licenses.unfree;
+    platforms = [ "x86_64-linux" ];
+    mainProgram = "t32marm";
+  };
+}
