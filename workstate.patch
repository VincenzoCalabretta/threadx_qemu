+load("@//tools/toolchain/cpp:common_defs.bzl", "C_COMPILE_ACTIONS", "CPP_ASSEMBLE_ACTIONS", "CPP_COMPILE_ACTIONS", "CPP_LINK_ACTIONS")
+
+_TOOL_PREFIX = "{{repo_path}}/bin/arm-none-eabi-"
+
+_M7_CPU_FLAGS = [
+    "-mcpu=cortex-m7",
+    "-mthumb",
+    "-mfpu=fpv5-d16",
+    "-mfloat-abi=hard",
+    "-mlittle-endian",
+]
+
+def _impl(ctx):
+    tool_paths = [
+        tool_path(name = "gcc",     path = _TOOL_PREFIX + "gcc"),
+        tool_path(name = "g++",     path = _TOOL_PREFIX + "g++"),
+        tool_path(name = "cpp",     path = _TOOL_PREFIX + "cpp"),
+        tool_path(name = "ar",      path = _TOOL_PREFIX + "ar"),
+        tool_path(name = "nm",      path = _TOOL_PREFIX + "nm"),
+        tool_path(name = "ld",      path = _TOOL_PREFIX + "ld"),
+        tool_path(name = "as",      path = _TOOL_PREFIX + "as"),
+        tool_path(name = "objdump", path = _TOOL_PREFIX + "objdump"),
+        tool_path(name = "objcopy", path = _TOOL_PREFIX + "objcopy"),
+        tool_path(name = "strip",   path = _TOOL_PREFIX + "strip"),
+        tool_path(name = "gcov",    path = _TOOL_PREFIX + "gcov"),
+        tool_path(name = "dwp",     path = "/bin/false"),
+    ]
+
+    # Discovered by: arm-none-eabi-gcc -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16
+    #                  -mfloat-abi=hard -xc++ -E -v -
+    include_dirs = {{include_dirs}}
+
+    features = [
+        feature(
+            name = "m7_cpu",
+            enabled = True,
+            flag_sets = [
+                flag_set(
+                    actions = CPP_COMPILE_ACTIONS + C_COMPILE_ACTIONS + CPP_ASSEMBLE_ACTIONS,
+                    flag_groups = [flag_group(flags = _M7_CPU_FLAGS)],
+                ),
+                flag_set(
+                    actions = CPP_LINK_ACTIONS,
+                    flag_groups = [flag_group(flags = _M7_CPU_FLAGS)],
+                ),
+            ],
+        ),
+        feature(
+            name = "gc_sections",
+            enabled = True,
+            flag_sets = [
+                flag_set(
+                    actions = CPP_COMPILE_ACTIONS + C_COMPILE_ACTIONS,
+                    flag_groups = [flag_group(flags = ["-ffunction-sections", "-fdata-sections"])],
+                ),
+                flag_set(
+                    actions = CPP_LINK_ACTIONS,
+                    flag_groups = [flag_group(flags = ["-Wl,--gc-sections"])],
+                ),
+            ],
+        ),
+        feature(
+            name = "newlib_nano",
+            enabled = True,
+            flag_sets = [
+                flag_set(
+                    actions = CPP_LINK_ACTIONS,
+                    flag_groups = [flag_group(flags = ["-specs=nano.specs", "-specs=nosys.specs"])],
+                ),
+            ],
+        ),
+        feature(name = "pic", enabled = False, flag_sets = []),
+        feature(
+            name = "dbg",
+            flag_sets = [flag_set(
+                actions = CPP_COMPILE_ACTIONS + C_COMPILE_ACTIONS,
+                flag_groups = [flag_group(flags = ["-O0", "-g3"])],
+            )],
+        ),
+        feature(
+            name = "fastbuild",
+            flag_sets = [flag_set(
+                actions = CPP_COMPILE_ACTIONS + C_COMPILE_ACTIONS,
+                flag_groups = [flag_group(flags = ["-O1"])],
+            )],
+        ),
+        feature(
+            name = "opt",
+            flag_sets = [flag_set(
+                actions = CPP_COMPILE_ACTIONS + C_COMPILE_ACTIONS,
+                flag_groups = [flag_group(flags = ["-O2", "-DNDEBUG"])],
+            )],
+        ),
+        feature(
+            name = "cpp_version",
+            enabled = True,
+            flag_sets = [flag_set(
+                actions = CPP_COMPILE_ACTIONS,
+                flag_groups = [flag_group(flags = ["-std=c++17"])],
+            )],
+        ),
+        feature(
+            name = "warnings",
+            enabled = True,
+            flag_sets = [flag_set(
+                actions = CPP_COMPILE_ACTIONS + C_COMPILE_ACTIONS,
+                flag_groups = [flag_group(flags = ["-Wall"])],
+            )],
+        ),
+    ]
+
+    return cc_common.create_cc_toolchain_config_info(
+        ctx = ctx,
+        toolchain_identifier = "{{toolchain_name}}-{{gcc_version}}",
+        compiler = "arm-none-eabi-gcc",
+        host_system_name = "local",
+        target_system_name = "arm-none-eabi",
+        target_cpu = "armv7e-m",
+        target_libc = "newlib",
+        abi_version = "eabi",
+        abi_libc_version = "newlib",
+        make_variables = [],
+        tool_paths = tool_paths,
+        features = features,
+        action_configs = [],
+        cxx_builtin_include_directories = include_dirs,
+    )
+
+cc_toolchain_config = rule(
+    implementation = _impl,
+    attrs = {},
+    provides = [CcToolchainConfigInfo],
+)
diff --git a/tools/toolchain/cpp/arm_gnu_m7_toolchain.bzl b/tools/toolchain/cpp/arm_gnu_m7_toolchain.bzl
new file mode 100644
index 000000000..dc73d1303
--- /dev/null
+++ b/tools/toolchain/cpp/arm_gnu_m7_toolchain.bzl
@@ -0,0 +1,106 @@
+"""(c) The Exploration Company.
+
+Downloads and configures the Arm GNU bare-metal toolchain for the Cortex-M7 target.
+Procures the binary from arm published binaries as a function of the
+host architecture.
+"""
+
+load("//tools/toolchain/cpp:probe.bzl", "probe_builtin_include_dirs")
+
+_ARCH_TO_ARM_HOST = {
+    "aarch64": "aarch64",
+    "amd64": "x86_64",
+    "arm64": "aarch64",
+    "x86_64": "x86_64",
+}
+
+_ARCH_TO_BAZEL_CPU = {
+    "aarch64": "aarch64",
+    "amd64": "x86_64",
+    "arm64": "aarch64",
+    "x86_64": "x86_64",
+}
+
+_M7_PROBE_FLAGS = [
+    "-mcpu=cortex-m7",
+    "-mthumb",
+    "-mfpu=fpv5-d16",
+    "-mfloat-abi=hard",
+]
+
+def _download_arm_gnu_m7_toolchain(rctx):
+    host_arch = rctx.os.arch
+    arm_host = _ARCH_TO_ARM_HOST.get(host_arch)
+    bazel_cpu = _ARCH_TO_BAZEL_CPU.get(host_arch)
+    if not arm_host:
+        fail("Unsupported host architecture for arm gnu toolchain: '{}'. Supported: {}".format(
+            host_arch,
+            list(_ARCH_TO_ARM_HOST.keys()),
+        ))
+
+    sha256 = rctx.attr.sha256.get(arm_host)
+    if not sha256:
+        fail("Missing sha256 for host '{}'. Provided keys: {}".format(arm_host, list(rctx.attr.sha256.keys())))
+
+    tarball_stem = "arm-gnu-toolchain-{version}-{host}-arm-none-eabi".format(
+        version = rctx.attr.version,
+        host = arm_host,
+    )
+    url = "{base}/{version}/binrel/{stem}.tar.xz".format(
+        base = rctx.attr.base_url,
+        version = rctx.attr.version,
+        stem = tarball_stem,
+    )
+
+    rctx.download_and_extract(
+        url = url,
+        sha256 = sha256,
+        stripPrefix = tarball_stem,
+    )
+
+    gcc_path = str(rctx.path("bin/arm-none-eabi-gcc"))
+
+    ver_result = rctx.execute([gcc_path, "-dumpversion"])
+    if ver_result.return_code != 0:
+        fail("Failed to query arm-none-eabi-gcc version: " + ver_result.stderr)
+    gcc_version = ver_result.stdout.strip()
+
+    include_dirs = probe_builtin_include_dirs(rctx, gcc_path, probe_flags = _M7_PROBE_FLAGS)
+
+    substitutions = {
+        "{{bazel_arch}}": bazel_cpu,
+        "{{gcc_version}}": gcc_version,
+        "{{include_dirs}}": repr(include_dirs),
+        "{{repo_path}}": str(rctx.path("")),
+        "{{toolchain_name}}": rctx.attr.toolchain_name,
+    }
+
+    rctx.template(
+        "BUILD.bazel",
+        Label("//tools/toolchain/cpp:arm_gnu_m7_BUILD.tmpl"),
+        substitutions = substitutions,
+    )
+    rctx.template(
+        rctx.attr.toolchain_name + "_config.bzl",
+        Label("//tools/toolchain/cpp:arm_gnu_m7_config.bzl.tmpl"),
+        substitutions = substitutions,
+    )
+
+download_arm_gnu_m7_toolchain = repository_rule(
+    implementation = _download_arm_gnu_m7_toolchain,
+    attrs = {
+        "base_url": attr.string(
+            default = "https://developer.arm.com/-/media/Files/downloads/gnu",
+            doc = "Base URL of the Arm GNU toolchain release directory.",
+        ),
+        "sha256": attr.string_dict(
+            mandatory = True,
+            doc = "SHA256 of the tarball, keyed by Arm host ('x86_64', 'aarch64').",
+        ),
+        "toolchain_name": attr.string(mandatory = True),
+        "version": attr.string(
+            mandatory = True,
+            doc = "Arm GNU toolchain version, e.g. '15.2.rel1'.",
+        ),
+    },
+)
